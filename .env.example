APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
LOG_LEVEL=info
DB_MAX_CONNS=10
# 本机开发允许 sslmode=disable；部署时使用数据库提供方要求的 TLS 配置。
DATABASE_URL=postgres://material_dispatch:CHANGE_ME@127.0.0.1:5432/material_dispatch?sslmode=disable
TEST_DATABASE_URL=postgres://material_dispatch:CHANGE_ME@127.0.0.1:5432/material_dispatch_test?sslmode=disable

APP_ORIGIN=http://127.0.0.1:5176
UPLOAD_DIR=.data/uploads

# 天地图服务端类型 Key；浏览器端 Key 不能用于后台算路。保持为空时不调用外部接口。
TIANDITU_SERVER_KEY=
# 北京时间每日刷新已使用路线；实际调用仍受账户配额限制。
ROUTE_REFRESH_HOUR=2
# 本项目每日调用预算（包括失败），不是供应商配额。
ROUTE_DAILY_LIMIT=1000
